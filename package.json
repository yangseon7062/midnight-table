{
  "name": "midnight-table",
  "version": "0.1.0",
  "private": true,
  "description": "심야 테이블 — 실시간 2D 멀티플레이어 보드게임 플랫폼 (머더미스터리 모듈 탑재)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"tsx watch server/src/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "vite build --config client/vite.config.ts",
    "start": "tsx server/src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node tests/run-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@preact/signals": "^2.11.2",
    "express": "^5.2.1",
    "galmuri": "^2.40.3",
    "multer": "^2.4.0",
    "preact": "^10.29.8",
    "pretendard": "^1.3.9",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.23.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.3",
    "concurrently": "^10.0.5",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
