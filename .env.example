# 이 파일을 복사해서 .env 로 쓰세요.  cp .env.example .env
# .env 는 .gitignore 에 있어 저장소에 올라가지 않습니다. 실제 키를 여기(.env.example)에 적지 마세요.

# ── 기본 ──
PORT=3000
ADMIN_PASSWORD=바꾸세요
# DATA_DIR=./data
# RECONNECT_GRACE_MS=120000

# ── HTTPS (마이크 권한에 필요. 리버스 프록시/터널 뒤라면 불필요) ──
# SSL_KEY_FILE=key.pem
# SSL_CERT_FILE=cert.pem

# ── TURN: 다른 망 사이 음성 연결용 ──
# 1순위 Metered — 서울 리전, 무료 500MB/월, 80·443 포트 지원.
#   서버가 이 REST 를 호출해 자격증명을 받아 캐시합니다. API 키는 브라우저로 나가지 않습니다.
# METERED_TURN_URL=https://<프로젝트>.metered.live/api/v1/turn/credentials
# METERED_API_KEY=

# 2순위 ExpressTURN — 프랑스, 무료 1000GB/월, 3478 포트만. 고정 자격증명.
# EXPRESSTURN_URL=turn:free.expressturn.com:3478
# EXPRESSTURN_USERNAME=
# EXPRESSTURN_CREDENTIAL=

# 위 두 개 대신 직접 목록을 넣고 싶을 때 (JSON). 지정하면 이 값이 우선합니다.
# ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
